<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>com.zhucanle.opencodev2.ide</id>
  <name>OpenCode V2 UI (unofficial)</name>
  <vendor url="https://github.com/ZhuCanle/OpenCodeV2_UI">zclyde</vendor>
  

  <description><![CDATA[
    <b>OpenCode V2 UI (unofficial) - AI Coding Agent for JetBrains IDEs</b><br><br>
    
    Seamlessly integrates <a href="https://opencode.ai">OpenCode V2</a> directly into your workflow.<br><br>
    <b>For OpenCode V2 Only!!!</b>
    
    <b>Key Features:</b><br>
    <ul>
        <li><b>Quick Launch:</b> Connect to the OpenCode v2 service, attach to a remote server, or open a new terminal with <code>Cmd+Esc</code> / <code>Ctrl+\</code>. Local connections authenticate automatically; remote servers use the password printed by <code>opencode serve</code>.</li>
        <li><b>Context Sharing:</b> Send current file, selection, or Project View items to the agent with <code>Opt+Cmd+K</code> / <code>Ctrl+Alt+K</code>.</li>
        <li><b>Native Diff Review:</b> Review AI-generated changes in a multi-file diff viewer. Accept stages changes (<code>git add</code>), Reject restores original content. Automatic snapshots ensure you can always recover previous versions.</li>
    </ul>
    <b>Based on OpenCode UI:</b> This plugin is a community derivative of
    <a href="https://github.com/LaiZhou/OpenCode_UI">OpenCode UI</a> by LaiZhou (MIT License),
    extended with opencode v2 support. It uses its own plugin id, name and keyboard shortcuts,
    so it can be installed alongside the original.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <!-- JCEF Browser Support (Optional) -->
  <depends optional="true" config-file="opencode-web-support.xml">com.intellij.modules.jcef</depends>

  <actions>
    <action id="OpenCodeV2.QuickLaunch"
            class="com.zhucanle.opencodev2.ide.QuickLaunchAction"
            text="Open OpenCode V2"
            description="Open or focus the OpenCode V2 terminal"
            icon="/icons/opencode.svg">
      <add-to-group group-id="ToolsMenu" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control BACK_SLASH"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ESCAPE"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ESCAPE"/>
    </action>

    <action id="OpenCodeV2.AddLines"
            class="com.zhucanle.opencodev2.ide.SendSelectionToTerminalAction"
            text="Add lines to OpenCode V2 Terminal"
            icon="/icons/opencode.svg">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K"/>
    </action>

    <action id="OpenCodeV2.AddFile"
            class="com.zhucanle.opencodev2.ide.SendSelectionToTerminalAction"
            text="Add to OpenCode V2 Terminal"
            icon="/icons/opencode.svg">
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K"/>
    </action>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Project-level Services -->
    <projectService serviceImplementation="com.zhucanle.opencodev2.ide.OpenCodeService"/>
    <projectService serviceImplementation="com.zhucanle.opencodev2.ide.session.SessionManager"/>
    <projectService serviceImplementation="com.zhucanle.opencodev2.ide.diff.DiffViewerService"/>

    <!-- File Editor Provider -->
    <fileEditorProvider implementation="com.zhucanle.opencodev2.ide.terminal.OpenCodeTerminalFileEditorProvider"/>
    <fileEditorProvider implementation="com.zhucanle.opencodev2.ide.web.OpenCodeWebFileEditorProvider"/>

    <!-- Notifications -->
    <notificationGroup id="OpenCodeV2" displayType="BALLOON"/>

    <toolWindow id="OpenCodeV2"
                factoryClass="com.zhucanle.opencodev2.ide.OpenCodeToolWindowFactory"
                icon="/icons/opencode.svg"
                anchor="right"/>

  </extensions>

  <projectListeners>
    <listener class="com.zhucanle.opencodev2.ide.terminal.OpenCodeTerminalEditorListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>
</idea-plugin>
